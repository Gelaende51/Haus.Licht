#!/usr/bin/env python3
"""hauslicht-ctl: tiny client for the hauslicht sync daemon (used by the Plasma widget).

    hauslicht-ctl get                     state as JSON
    hauslicht-ctl set KEY=VALUE           mode, lid, flick (off|on|fast|exclusive),
                                          exclusive_adapter (hciN|MAC|auto) globally;
                                          track, off_at_zero, range_lo, range_hi,
                                          curve, level on the selection's profile
    hauslicht-ctl slider N | toggle | on | off | pause | resume | bulb N
    hauslicht-ctl nudge N                 move the slider by N (signed; in mode off
                                          the brightness): scroll on the tray icon
    hauslicht-ctl select ID|all
    hauslicht-ctl order ID ID ...         the list order (every bulb id once)
    hauslicht-ctl bulb-set ID name=... profile=... use=on|off icon_on=... icon_off=...
    hauslicht-ctl widget-bulbs ID,ID...   the bulbs of the widget (none: empty)
    hauslicht-ctl profile save|apply|delete NAME | profile rename OLD NEW
                                          (preset ... is the same)
    hauslicht-ctl discover [KIND] | add KIND key=value... | remove ID | backends
    hauslicht-ctl adapters                Bluetooth adapters flick mode exclusive can take
    hauslicht-ctl clap off|clap|snap|both | clap-sources | clap-meter
                                          double clap/snap toggle, its microphones, test meter
    hauslicht-ctl watch                   a snapshot, then one JSON line per change
                                          until interrupted
    hauslicht-ctl @N COMMAND ...          the command in widget N's context

Every command and the full `get` JSON: docs/ctl-protocol.md. Socket only: no
btmesh, no venv. Prints the daemon's reply as one JSON line; exit 1 with
{"error": ...} when the daemon is not running or refuses. HAUSLICHT_SOCK
points at another daemon's socket (a test instance).
"""
import json
import os
import socket
import sys
from pathlib import Path

SOCK = Path(os.environ.get("HAUSLICHT_SOCK")
            or Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hauslicht.sock")


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, arg = argv[0], " ".join(argv[1:]) or None
    if argv[0] == "watch" or (argv[0].startswith("@") and argv[1:2] == ["watch"]):
        return watch(cmd, argv[1:])
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(30)
            s.connect(str(SOCK))
            s.sendall(json.dumps({"cmd": cmd, "arg": arg, "args": argv[1:], "which": None}).encode() + b"\n")
            data = b""
            while not data.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                data += chunk
        reply = json.loads(data)
    except (OSError, ValueError) as exc:
        print(json.dumps({"error": f"daemon not reachable: {exc}"}))
        return 1
    if "error" in reply:
        print(json.dumps(reply))
        return 1
    print(json.dumps(reply["results"][0]))
    return 0


def watch(cmd: str, args: list[str]) -> int:
    """Print the daemon's lines as they come, until it closes or Ctrl+C."""
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(str(SOCK))
            s.sendall(json.dumps({"cmd": cmd, "args": args, "which": None}).encode() + b"\n")
            with s.makefile("rb") as lines:
                for line in lines:
                    sys.stdout.write(line.decode())
                    sys.stdout.flush()
    except OSError as exc:
        print(json.dumps({"error": f"daemon not reachable: {exc}"}))
        return 1
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
