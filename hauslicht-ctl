#!/usr/bin/env python3
"""hauslicht-ctl: tiny client for the hauslicht sync daemon (used by the Plasma widget).

    hauslicht-ctl get                     state as JSON
    hauslicht-ctl set KEY=VALUE           mode, lid, flick (on|off) globally;
                                          track, off_at_zero, range_lo, range_hi,
                                          curve, level on the selection's profile
    hauslicht-ctl slider N | toggle | on | off | pause | resume | bulb N
    hauslicht-ctl nudge N                 move the slider by N (signed; in mode off
                                          the brightness): scroll on the tray icon
    hauslicht-ctl select ID|all
    hauslicht-ctl bulb-set ID name=... profile=...
    hauslicht-ctl profile save|apply|delete NAME | profile rename OLD NEW
                                          (preset ... is the same)
    hauslicht-ctl discover [KIND] | add KIND key=value... | remove ID | backends

Every command and the full `get` JSON: docs/ctl-protocol.md. Socket only: no
btmesh, no venv. Prints the daemon's reply as one JSON line; exit 1 with
{"error": ...} when the daemon is not running or refuses. HAUSLICHT_SOCK
points at another daemon's socket (a test instance).
"""
import json
import os
import socket
import sys
from pathlib import Path

SOCK = Path(os.environ.get("HAUSLICHT_SOCK")
            or Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "hauslicht.sock")


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, arg = argv[0], " ".join(argv[1:]) or None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(30)
            s.connect(str(SOCK))
            s.sendall(json.dumps({"cmd": cmd, "arg": arg, "args": argv[1:], "which": None}).encode() + b"\n")
            data = b""
            while not data.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                data += chunk
        reply = json.loads(data)
    except (OSError, ValueError) as exc:
        print(json.dumps({"error": f"daemon not reachable: {exc}"}))
        return 1
    if "error" in reply:
        print(json.dumps(reply))
        return 1
    print(json.dumps(reply["results"][0]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
