#!/usr/bin/env python3
"""lichthaus-ctl: tiny client for the lichthaus sync daemon (used by the Plasma widget).

    lichthaus-ctl get                     state as JSON
    lichthaus-ctl set KEY=VALUE           mode, track, screen_state, lid_state,
                                          range_lo, range_hi, curve
    lichthaus-ctl slider N | toggle | on | off | resume
    lichthaus-ctl preset save|apply|delete NAME

Socket only: no btmesh, no venv. Prints the daemon's state as one JSON line;
exit 1 with {"error": ...} when the daemon is not running or refuses.
"""
import json
import os
import socket
import sys
from pathlib import Path

SOCK = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "lichthaus.sock"


def main(argv: list[str]) -> int:
    if not argv:
        print(__doc__, file=sys.stderr)
        return 2
    cmd, arg = argv[0], " ".join(argv[1:]) or None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(30)
            s.connect(str(SOCK))
            s.sendall(json.dumps({"cmd": cmd, "arg": arg, "which": None}).encode() + b"\n")
            data = b""
            while not data.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                data += chunk
        reply = json.loads(data)
    except (OSError, ValueError) as exc:
        print(json.dumps({"error": f"daemon not reachable: {exc}"}))
        return 1
    if "error" in reply:
        print(json.dumps(reply))
        return 1
    print(json.dumps(reply["results"][0]))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
